{
  "title": "Solar Forecast Monitoring",
  "uid": "solar-forecast-monitoring",
  "schemaVersion": 36,
  "version": 1,
  "editable": true,
  "time": { "from": "now-30d", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "refresh": "",
  "tags": [],
  "panels": [
    {
      "id": 4,
      "title": "Current RMSE",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 9 },
      "datasource": { "type": "postgres", "uid": "P78DC24F8AA21B398" },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT rmse FROM monitoring_metrics ORDER BY created_at DESC LIMIT 1",
          "format": "table",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "red", "value": 2000 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      }
    },
    {
      "id": 5,
      "title": "Current MAE",
      "type": "stat",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 9 },
      "datasource": { "type": "postgres", "uid": "P78DC24F8AA21B398" },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT mae FROM monitoring_metrics ORDER BY created_at DESC LIMIT 1",
          "format": "table",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "red", "value": 2000 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "title": "RMSE and MAE Over Time",
      "type": "timeseries",
      "gridPos": { "x": 8, "y": 0, "w": 16, "h": 9 },
      "datasource": { "type": "postgres", "uid": "P78DC24F8AA21B398" },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT run_date AS \"time\", rmse, mae FROM monitoring_metrics ORDER BY run_date",
          "format": "table",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      }
    },
    {
      "id": 1,
      "title": "Predictions vs Actuals",
      "description": "Hourly solar production forecast compared to Elia measured actuals for Flanders (MW)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 9, "w": 24, "h": 10 },
      "datasource": { "type": "postgres", "uid": "P78DC24F8AA21B398" },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT tijd AS \"time\", predicted_mw, actual_mw FROM predictions WHERE $__timeFilter(tijd) ORDER BY tijd",
          "format": "table",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      }
    },
    {
      "id": 2,
      "title": "Prediction Error Over Time",
      "description": "Difference between actual and predicted production per hour. Positive means the model underestimates, negative means it overestimates.",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 19, "w": 24, "h": 10 },
      "datasource": { "type": "postgres", "uid": "P78DC24F8AA21B398" },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT tijd AS \"time\", actual_mw - predicted_mw AS error_mw FROM predictions WHERE $__timeFilter(tijd) AND actual_mw IS NOT NULL ORDER BY tijd",
          "format": "table",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      }
    }
  ],
  "__inputs": [
    {
      "name": "DS_GRAFANA-POSTGRESQL-DATASOURCE",
      "label": "grafana-postgresql-datasource",
      "description": "",
      "type": "datasource",
      "pluginId": "postgres",
      "pluginName": "PostgreSQL"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "postgres", "name": "PostgreSQL", "version": "1.0.0" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" }
  ]
}
